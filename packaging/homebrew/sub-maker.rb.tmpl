# frozen_string_literal: true

# Homebrew formula for tsonubin/homebrew-tap (generated by release CI).
#   brew tap tsonubin/tap
#   brew install sub-maker
class SubMaker < Formula
  desc "TUI to set up a sing-box proxy server and Clash subscription"
  homepage "https://github.com/tsonubin/sub-maker"
  version "__VERSION__"
  license :cannot_represent

  livecheck do
    url :stable
    regex(/^v?(\d+(?:\.\d+)+)$/i)
  end

  on_macos do
    on_arm do
      url "https://github.com/tsonubin/sub-maker/releases/download/v__VERSION__/sub-maker-darwin-arm64"
      sha256 "__SHA_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/tsonubin/sub-maker/releases/download/v__VERSION__/sub-maker-darwin-amd64"
      sha256 "__SHA_DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/tsonubin/sub-maker/releases/download/v__VERSION__/sub-maker-linux-arm64"
      sha256 "__SHA_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/tsonubin/sub-maker/releases/download/v__VERSION__/sub-maker-linux-amd64"
      sha256 "__SHA_LINUX_AMD64__"
    end
  end

  def install
    # GitHub asset names become the local filename when downloaded.
    binary = Dir["sub-maker-*"].first || "sub-maker"
    bin.install binary => "sub-maker"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/sub-maker --version")
  end

  def caveats
    <<~EOS
      sub-maker is primarily for Linux VPS setup (systemd, /etc paths).

      Production setup (Linux, root):
        sudo sub-maker --setup

      Demo / non-root:
        SUB_MAKER_DEMO=1 sub-maker --setup

      Full install docs: https://github.com/tsonubin/sub-maker/blob/main/INSTALL.md
    EOS
  end
end
